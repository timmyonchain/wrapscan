# Sepolia RPC endpoint (used by the app and the ground-truth script).
# Use your own provider (Alchemy/Infura/etc.) for reliable rate limits.
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Required for WalletConnect-based wallets in RainbowKit.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
