# SERVER-ONLY Sepolia RPC endpoint (no NEXT_PUBLIC_ prefix -> never shipped to
# the browser). The browser talks to the same-origin /api/rpc proxy, which
# forwards here server-side; the headless spike and /api/registry use it directly.
# Use your own provider (Alchemy/Infura/etc.) for reliable rate limits.
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Required for WalletConnect-based wallets in RainbowKit.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
